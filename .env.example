# Copy to .env and fill in. Required every boot (secrets are never persisted
# to config.json): DB_PASSWORD, DISCORD_CLIENT_SECRET, SESSION_SIGNING_SECRET,
# TOKEN_ENCRYPTION_KEY. Everything else is only needed on first boot — after
# that it's persisted to /app/data/config.json and can be dropped here.

DB_PASSWORD=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
INITIAL_ROOT_DISCORD_ID=

# Generate with: openssl rand -hex 32
SESSION_SIGNING_SECRET=
TOKEN_ENCRYPTION_KEY=

# Optional — invite emails via SMTP. Leave unset to disable.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Party Planner <no-reply@example.com>
