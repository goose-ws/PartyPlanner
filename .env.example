# Nothing here is strictly required anymore. Leave this entire file empty
# (or don't create it at all) and the app boots into a first-run setup
# wizard in your browser, where you enter everything below — it gets saved
# to /app/data/config.json (owner-read-only), and the container just needs
# a restart afterward to pick it up.
#
# If you'd rather configure via environment instead of the wizard (e.g. for
# infra-as-code / secrets-manager setups), anything set here takes
# precedence over config.json, every boot.

# PUBLIC_URL=https://partyplanner.example.com
# DB_HOST=mariadb
# DB_PORT=3306
# DB_USER=
# DB_NAME=
# DB_PASSWORD=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# INITIAL_ROOT_DISCORD_ID=

# Auto-generated and persisted to config.json if left unset — only set
# these if you specifically want to manage them outside the app.
# SESSION_SIGNING_SECRET=
# TOKEN_ENCRYPTION_KEY=
